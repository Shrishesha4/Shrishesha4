# Public Firebase browser configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_EMAILS=

# Telegram (optional — leave unset to run without Telegram capture/commands)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ntfy (optional — leave unset to run without ntfy push notifications)
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_ACCESS_TOKEN=

# AI (optional — leave unset to run without AI features)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

